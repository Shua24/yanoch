@page "/new"
@page "/page/{PageId:guid}"
@layout MainLayout
@inject IPageService PageService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JSRuntime

<div class="editor-page">
    @if (loading)
    {
        <div class="loading">@(isNew ? "Creating..." : "Loading...")</div>
    }
    else if (page == null && !isNew)
    {
        <div class="error-state">Page not found</div>
    }
    else
    {
        <div class="editor-header">
            <div class="editor-header-top">
                <div class="editor-icon">
                    <button class="icon-display" @onclick="ToggleEmojiPicker" title="Change icon">@(string.IsNullOrEmpty(page!.Icon) ? "📄" : page.Icon)</button>
                @if (_showEmojiPicker)
                {
                    <div class="emoji-picker" @onclick:stopPropagation="true">
                        <div class="emoji-picker-header">Pick an icon</div>
                        <div class="emoji-picker-grid">
                            @foreach (var emoji in _emojis)
                            {
                                <button class="emoji-option" @onclick="() => SelectEmoji(emoji)">@emoji</button>
                            }
                        </div>
                    </div>
                }
                </div>
                <div class="editor-actions">
                    <button class="btn-delete-page" @onclick="DeletePage" title="Delete page">🗑️ Delete</button>
                </div>
            </div>
            <textarea rows="1" id="page-title-input" @bind="page!.Title" @bind:after="async () => await SavePageMetaAsync()" class="title-input" placeholder="Untitled" @onkeydown="HandleTitleKeyDown"></textarea>
            <div class="editor-meta">
                <span>Updated @(page!.UpdatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm"))</span>
                @if (!string.IsNullOrEmpty(_saveStatus))
                {
                    <span class="save-status saving">@_saveStatus</span>
                }
            </div>
        </div>

        @if (page!.Tags.Any())
        {
            <div class="editor-tags">
                @foreach (var tag in page.Tags)
                {
                    <span class="tag-badge" style="background:@(tag.Color ?? "#e0e0e0")">@tag.Name</span>
                }
            </div>
        }

        <!-- TipTap editor mounts here -->
        <div id="tiptap-editor" class="editor-tiptap"></div>

        @if (page.Backlinks.Any())
        {
            <div class="editor-backlinks">
                <h4>Backlinks</h4>
                <div class="backlinks-list">
                    @foreach (var bl in page.Backlinks)
                    {
                        <a href="/page/@(bl.SourcePageId)" class="backlink-item">@bl.SourcePageTitle</a>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    public static event Action? OnPageDataChanged;
    [Parameter] public Guid PageId { get; set; }
    private PageDto? page;
    private bool loading = true;
    private bool isNew;
    private string _saveStatus = "";
    private Guid currentUserId;
    private bool _showEmojiPicker;
    private DotNetObjectReference<Editor>? _dotNetRef;
    private bool _editorInitialized;
    private DateTime _lastSave = DateTime.MinValue;
    private const int SaveDebounceMs = 800;

    private static readonly string[] _emojis = new[] {
        "📄", "📝", "📋", "📌", "📎", "✏️", "📖", "📕", "📗", "📘",
        "📙", "📚", "📓", "📒", "📃", "📑", "🔖", "🏷️", "💡", "⭐",
        "🎯", "🔥", "💻", "🎨", "🎵", "🎬", "📷", "✈️", "🏠", "🛒",
        "❤️", "💪", "🧠", "🎉", "✅", "🔄", "📊", "🗂️", "📁", "🔐",
        "🌍", "🎓", "💼", "🎮", "📱", "☕", "🍕", "🏀", "⚽", "🎸"
    };

    private void ToggleEmojiPicker() => _showEmojiPicker = !_showEmojiPicker;

    private async Task SelectEmoji(string emoji)
    {
        if (page == null) return;
        page.Icon = emoji;
        _showEmojiPicker = false;
        await SavePageMetaAsync();
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login");
            return;
        }
        var userIdClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(userIdClaim) || !Guid.TryParse(userIdClaim, out currentUserId))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadPageForRoute();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadPageForRoute();
    }

    private string? _lastLoadedRoute;

    private async Task LoadPageForRoute()
    {
        var newIsNew = Navigation.Uri.EndsWith("/new", StringComparison.OrdinalIgnoreCase);
        var currentRoute = Navigation.Uri;
        if (currentRoute == _lastLoadedRoute)
            return;
        _lastLoadedRoute = currentRoute;

        // Destroy any previous TipTap editor
        await DestroyEditor();

        isNew = newIsNew;

        if (isNew)
        {
            page = new PageDto
            {
                Id = Guid.NewGuid(),
                Title = "Untitled",
                Icon = "📄",
                Content = "",
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };
            loading = false;
            _editorInitialized = false;
        }
        else
        {
            if (page == null || page.Id != PageId)
            {
                page = null;
                loading = true;
                StateHasChanged();
                await Task.Yield();
                page = await PageService.GetByIdAsync(PageId, currentUserId);
                _editorInitialized = false;
            }
            loading = false;
        }
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_editorInitialized && !loading && page != null)
        {
            await InitEditor();
            _editorInitialized = true;
        }
    }

    private async Task InitEditor()
    {
        try
        {
            _dotNetRef = DotNetObjectReference.Create(this);

            // Load content from API if existing page
            string content;
            if (isNew)
            {
                content = "";
            }
            else
            {
                content = await PageService.GetContentAsync(page!.Id, currentUserId) ?? "";
            }

            await JSRuntime.InvokeVoidAsync("initTipTap", "tiptap-editor", content, _dotNetRef, page!.Id.ToString());
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error initializing TipTap: " + ex.Message);
        }
    }

    private async Task DestroyEditor()
    {
        _editorInitialized = false;
        _dotNetRef?.Dispose();
        _dotNetRef = null;
        try
        {
            await JSRuntime.InvokeVoidAsync("destroyTipTap", "tiptap-editor");
        }
        catch { }
    }

    public void Dispose()
    {
        _ = DestroyEditor();
    }

    /// <summary>
    /// Called from JS interop when TipTap content changes.
    /// </summary>
    [JSInvokable]
    public async Task OnMarkdownChanged(string blockId, string markdown)
    {
        if (isNew || page == null) return;

        var now = DateTime.UtcNow;
        if ((now - _lastSave).TotalMilliseconds < SaveDebounceMs) return;
        _lastSave = now;

        try
        {
            _saveStatus = "Saving...";
            StateHasChanged();
            await PageService.SetContentAsync(page.Id, markdown);
            page.Content = markdown;
            page.UpdatedAt = now;
            OnPageDataChanged?.Invoke();
            _saveStatus = "";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _saveStatus = "";
            Console.WriteLine("Save error: " + ex.Message);
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task OnFocus(string blockId)
    {
        // Focus tracking if needed
    }

    [JSInvokable]
    public async Task OnBlur(string blockId)
    {
        // Blur tracking if needed
    }

    private async Task HandleTitleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            try { await JSRuntime.InvokeVoidAsync("blurElementById", "page-title-input"); }
            catch { }
        }
    }

    private async Task SavePageMetaAsync()
    {
        if (page == null) return;
        try
        {
            if (isNew)
            {
                var newPage = await PageService.CreateAsync(new CreatePageDto
                {
                    Title = page.Title,
                    Icon = page.Icon,
                    Content = "",
                }, currentUserId);
                if (newPage != null)
                {
                    OnPageDataChanged?.Invoke();
                    Navigation.NavigateTo($"/page/{newPage.Id}");
                }
            }
            else
            {
                await PageService.UpdateAsync(page.Id, new UpdatePageDto { Title = page.Title, Icon = page.Icon }, currentUserId);
                OnPageDataChanged?.Invoke();
            }
        }
        catch { }
    }

    private async Task DeletePage()
    {
        if (page == null) return;
        try { await PageService.DeleteAsync(page.Id, currentUserId); OnPageDataChanged?.Invoke(); Navigation.NavigateTo("/"); } catch { }
    }
}
