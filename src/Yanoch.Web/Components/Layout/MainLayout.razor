@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JSRuntime

<div class="yanoch-layout">
    <aside class="yanoch-sidebar">
        <div class="sidebar-header">
            <a href="/" class="sidebar-logo">Yanoch</a>
        </div>
        <div class="sidebar-search">
            <input type="text" placeholder="Search pages..." @onkeyup="HandleSearchKey" @bind="searchQuery" />
        </div>
        <div class="sidebar-actions">
            <button class="btn-new-page" @onclick="CreateNewPage">+ New Page</button>
        </div>
        <div class="sidebar-nav">
            <AuthorizeView>
                <Authorized>
                    <PageTree />
                </Authorized>
            </AuthorizeView>
        </div>
        <div class="sidebar-footer">
            <AuthorizeView>
                <Authorized>
                    <div class="user-handle">
                        <a href="/trash" class="btn-trash" title="Trash">Trash</a>
                        <span class="user-name">@context.User.Identity?.Name</span>
                    </div>
                    <a href="/logout" class="btn-logout">Sign out</a>
                </Authorized>
                <NotAuthorized>
                    <a href="/login" class="btn-login">Sign in</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </aside>
    <main class="yanoch-main">
        @Body
    </main>
</div>

<button class="theme-toggle"
        type="button"
        title="Toggle dark mode"
        aria-label="Toggle dark mode"
        @onclick="ToggleTheme">
    <span class="icon-moon" aria-hidden="true">🌙</span>
    <span class="icon-sun" aria-hidden="true">☀️</span>
</button>

@code {
    private string searchQuery = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            if (!state.User.Identity?.IsAuthenticated == true
                && !Navigation.Uri.Contains("/login")
                && !Navigation.Uri.Contains("/register"))
            {
                Navigation.NavigateTo("/login");
            }
        }
    }

    private void HandleSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(searchQuery))
        {
            Navigation.NavigateTo($"/search?q={Uri.EscapeDataString(searchQuery)}");
        }
    }

    private void CreateNewPage()
    {
        Navigation.NavigateTo("/new");
    }

    private async Task ToggleTheme()
    {
        // The script is loaded synchronously in <head> from App.razor, so
        // window.yanochTheme is available as soon as the circuit is up.
        // Fire-and-forget: there's no UI state on the component itself,
        // the .dark class on <html> drives everything via CSS variables.
        try
        {
            await JSRuntime.InvokeVoidAsync("yanochTheme.toggle");
        }
        catch (InvalidOperationException)
        {
            // Pre-render / circuit not ready — ignore. The button only
            // matters on interactive sessions, and theme.js is idempotent.
        }
    }
}