@implements IDisposable
@inject IPageService PageService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState
@inject UserManager<IdentityUser> UserManager
@inject IPageDataNotifier PageDataNotifier

<div class="tree-node" style="padding-left: @(Depth * 16)px">
    <div class="tree-node-row">
        @if (Page.ChildCount > 0)
        {
            <button class="tree-node-toggle" @onclick="ToggleExpanded" @onclick:stopPropagation title="@(_expanded ? "Collapse" : "Expand")">
                <span class="tree-node-toggle-icon">@(_expanded ? "▾" : "▸")</span>
            </button>
        }
        else
        {
            <span class="tree-node-toggle-spacer"></span>
        }
        <a href="/page/@Page.Id" class="tree-node-link @(IsActive ? "active" : "")">
            <span class="tree-node-icon">@(Page.Icon ?? "📄")</span>
            <span class="tree-node-title">@Page.Title</span>
            @if (Page.ChildCount > 0)
            {
                <span class="tree-node-count">@Page.ChildCount</span>
            }
        </a>
        <button class="tree-node-menu-btn" @onclick="ToggleMenu" @onclick:stopPropagation>⋮</button>
    </div>
    @if (showMenu)
    {
        <div class="tree-node-menu" @onclick:stopPropagation>
            <button class="tree-node-menu-item tree-node-menu-item-danger" @onclick="DeletePage">Delete</button>
        </div>
    }
    @if (_expanded)
    {
        <div class="tree-node-children">
            @if (_loadingChildren)
            {
                <div class="tree-loading">Loading...</div>
            }
            else if (_children != null)
            {
                @foreach (var child in _children)
                {
                    <PageTreeNode @key="child.Id" Page="child" Depth="@(Depth + 1)" />
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public PageDto Page { get; set; } = new();
    [Parameter] public int Depth { get; set; } = 0;

    private bool showMenu;
    private bool _expanded;
    private bool _loadingChildren;
    private List<PageDto>? _children;
    private Guid currentUserId;

    private bool IsActive => Navigation.Uri.Contains($"/page/{Page.Id}") || Navigation.Uri.Contains($"/editor/{Page.Id}");

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            var user = await UserManager.GetUserAsync(state.User);
            if (user != null) currentUserId = Guid.Parse(user.Id);
        }

        PageDataNotifier.PageDataChanged += OnPageDataChanged;
    }

    private void ToggleMenu()
    {
        showMenu = !showMenu;
        StateHasChanged();
    }

    private async Task ToggleExpanded()
    {
        _expanded = !_expanded;
        if (_expanded && _children == null)
        {
            await LoadChildrenAsync();
        }
        StateHasChanged();
    }

    private async Task LoadChildrenAsync()
    {
        _loadingChildren = true;
        StateHasChanged();
        try
        {
            var children = await PageService.GetChildrenAsync(Page.Id, currentUserId);
            _children = children.ToList();
        }
        catch
        {
            _children = new();
        }
        _loadingChildren = false;
    }

    private async Task DeletePage()
    {
        showMenu = false;
        await PageService.SoftDeleteAsync(Page.Id, currentUserId);
        PageDataNotifier.NotifyPageDataChanged(Page.Id);
        if (Navigation.Uri.Contains($"/page/{Page.Id}") || Navigation.Uri.Contains($"/editor/{Page.Id}"))
        {
            Navigation.NavigateTo("/");
        }
    }

    private async void OnPageDataChanged(Guid? changedPageId)
    {
        try
        {
            // Only reload if the change affects this node or one of its
            // descendants. A null signal means "broad change — reload if
            // expanded" for backward-compatibility.
            if (changedPageId.HasValue &&
                changedPageId.Value != Page.Id &&
                !_isDescendantOf(changedPageId.Value))
                return;

            if (!_expanded) return;

            await InvokeAsync(async () =>
            {
                if (_children != null)
                {
                    await LoadChildrenAsync();
                    StateHasChanged();
                }
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[PageTreeNode] OnPageDataChanged refresh failed: {ex.Message}");
        }
    }

    /// <summary>
    /// Checks whether <paramref name="candidateId"/> is a direct child
    /// of this node or a descendant deeper in the tree.
    /// </summary>
    private bool _isDescendantOf(Guid candidateId)
    {
        if (_children == null) return false;
        foreach (var child in _children)
        {
            if (child.Id == candidateId) return true;
            // Recurse is not possible here since we don't hold child
            // tree references. The child PageTreeNode components own
            // their own filtering, so a child's OnPageDataChanged will
            // handle its own descendants. We only need to check direct
            // children here — if the changed page is a grandchild, the
            // direct child's handler will pick it up.
        }
        return false;
    }

    public void Dispose()
    {
        PageDataNotifier.PageDataChanged -= OnPageDataChanged;
    }
}
