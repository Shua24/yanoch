@implements IDisposable
@inject IPageService PageService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState
@inject UserManager<IdentityUser> UserManager

<div class="page-tree">
    @if (_isUnauthenticated)
    {
        <div class="tree-empty">
            <a href="/login">Sign in</a> to view pages
        </div>
    }
    else if (pages == null)
    {
        <div class="tree-loading">Loading...</div>
    }
    else if (pages.Count == 0)
    {
        <div class="tree-empty">No pages yet</div>
    }
    else
    {
        @foreach (var page in pages)
        {
            <PageTreeNode @key="page.Id" Page="page" Depth="0" />
        }
    }
</div>

@code {
    private List<PageDto>? pages;
    private bool _isUnauthenticated;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        Editor.OnPageDataChanged += OnPageDataChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPages();
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        await InvokeAsync(async () =>
        {
            await LoadPages();
            StateHasChanged();
        });
    }

    private async Task LoadPages()
    {
        try
        {
            // Resolve auth state first. If the user isn't authenticated, show the
            // "sign in" prompt and clear any stale tree data.
            var state = await AuthState.GetAuthenticationStateAsync();
            if (state.User.Identity?.IsAuthenticated != true)
            {
                _isUnauthenticated = true;
                pages = null;
                return;
            }

            _isUnauthenticated = false;

            var user = await UserManager.GetUserAsync(state.User);
            if (user == null)
            {
                _isUnauthenticated = true;
                pages = null;
                return;
            }

            var userId = Guid.Parse(user.Id);
            var result = await PageService.GetTreeAsync(userId);
            pages = result.ToList();
        }
        catch (Exception ex)
        {
            // Log the error so it's visible in the server console (avoid silent
            // failure). The tree keeps its previous value instead of wiping it.
            Console.WriteLine($"[PageTree] LoadPages failed: {ex.Message}");
        }
    }

    private async void OnPageDataChanged()
    {
        try
        {
            // InvokeAsync guarantees StateHasChanged runs on the Blazor sync
            // context, ensuring the render batch is enqueued correctly even
            // when the event fires from a JSInvokable call (e.g. TipTap save).
            await InvokeAsync(async () =>
            {
                await LoadPages();
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[PageTree] OnPageDataChanged refresh failed: {ex.Message}");
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Editor.OnPageDataChanged -= OnPageDataChanged;
    }
}
