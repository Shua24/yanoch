<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
  </PropertyGroup>

  <ItemGroup>
    <!-- IdentityUser/IdentityUserContext come from Microsoft.Extensions.Identity.Stores, which is
         NOT part of the Microsoft.AspNetCore.App shared framework. -->
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" Version="10.0.12" />
    <PackageReference Include="Markdig" Version="1.4.0" />
  </ItemGroup>

</Project>
