@page "/register"
@using System.ComponentModel.DataAnnotations
@using Yanoch.Domain
@using Yanoch.Ui.Components.Account
@using Yanoch.Ui.Components.Account.Shared
@using Microsoft.AspNetCore.Identity

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager NavigationManager

<PageTitle>Create account — Yanoch</PageTitle>

<div class="yanoch-auth-wrapper">
    <div class="yanoch-auth-form">
        <h2>Create an account</h2>

        <StatusMessage Message="@DisplayedStatusMessage" />

        @* Posts back to THIS page: the component handles the POST (static SSR, so HttpContext
           exists), creates the account through UserManager and then signs the user in. *@
        <EditForm Model="Input" method="post" OnValidSubmit="RegisterUserAsync" FormName="register">
            <DataAnnotationsValidator />

            <label for="reg-display-name">Display name</label>
            <InputText id="reg-display-name" @bind-Value="Input.DisplayName" maxlength="128"
                       placeholder="Your name or handle" autocomplete="nickname" />
            <ValidationMessage For="() => Input.DisplayName" class="yanoch-error" />

            <label for="reg-email">Email</label>
            <InputText id="reg-email" type="email" @bind-Value="Input.Email"
                       placeholder="you@example.com" autocomplete="username" />
            <ValidationMessage For="() => Input.Email" class="yanoch-error" />

            <label for="reg-password">Password</label>
            <InputText id="reg-password" type="password" @bind-Value="Input.Password"
                       placeholder="At least 8 characters" autocomplete="new-password" />
            <ValidationMessage For="() => Input.Password" class="yanoch-error" />

            <label for="reg-password-confirm">Confirm password</label>
            <InputText id="reg-password-confirm" type="password" @bind-Value="Input.ConfirmPassword"
                       placeholder="Repeat password" autocomplete="new-password" />
            <ValidationMessage For="() => Input.ConfirmPassword" class="yanoch-error" />

            @* No explicit <AntiforgeryToken /> here: EditForm already emits one, and a second
               input with the same name makes antiforgery validation fail with 400. *@
            <button type="submit" class="yanoch-primary-button">Create account</button>
        </EditForm>

        <p class="yanoch-muted yanoch-auth-alt">
            Already have an account?
            <a href="@AccountNavigation.BuildLoginUrl(ReturnUrl, loginFailed: false)" class="yanoch-link-button">
                Sign in
            </a>
        </p>
    </div>
</div>

@code {
    private string? identityErrorText;

    [SupplyParameterFromQuery(Name = AccountPaths.ReturnUrlQueryName)]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromForm]
    private RegisterInput Input { get; set; } = default!;

    private string? DisplayedStatusMessage
        => identityErrorText is null ? null : $"Error: {identityErrorText}";

    protected override void OnInitialized()
    {
        Input ??= new RegisterInput();
    }

    private async Task RegisterUserAsync()
    {
        string email = Input.Email!.Trim();
        string displayName = Input.DisplayName!.Trim();

        ApplicationUser user = new() { DisplayName = displayName };
        await UserManager.SetUserNameAsync(user, email);
        await UserManager.SetEmailAsync(user, email);

        IdentityResult result = await UserManager.CreateAsync(user, Input.Password!);
        if (!result.Succeeded)
        {
            identityErrorText = string.Join(", ", result.Errors.Select(error => error.Description));
            return;
        }

        // Sign in immediately: RequireConfirmedAccount is false, so there is nothing to wait for.
        // A persistent cookie keeps the desktop app signed in across a restart.
        await SignInManager.SignInAsync(user, isPersistent: true);
        NavigationManager.NavigateTo(AccountNavigation.ReadSafeReturnUrl(ReturnUrl), forceLoad: true);
    }

    public sealed class RegisterInput
    {
        [Required(ErrorMessage = "Display name is required.")]
        [StringLength(128, ErrorMessage = "Display name must be 128 characters or fewer.")]
        public string? DisplayName { get; set; }

        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string? Email { get; set; }

        [Required(ErrorMessage = "Password is required.")]
        [DataType(DataType.Password)]
        public string? Password { get; set; }

        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "The password and confirmation password do not match.")]
        public string? ConfirmPassword { get; set; }
    }
}
